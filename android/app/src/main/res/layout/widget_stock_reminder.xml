<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_dark"
    android:padding="12dp">

    <!-- Top Header: Product Activity + Theme Switcher Icon + Live Badge -->
    <LinearLayout
        android:id="@+id/widget_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/app_logo"
            android:scaleType="fitCenter"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Product Activity"
            android:textColor="#f8fafc"
            android:textStyle="bold"
            android:textSize="13.5sp" />

        <!-- Theme Toggle Circular Icon Button -->
        <TextView
            android:id="@+id/widget_theme_toggle"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:background="@drawable/widget_theme_btn_dark_bg"
            android:text="☀️"
            android:gravity="center"
            android:textSize="12sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/widget_sync_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Live"
            android:textColor="#38bdf8"
            android:textStyle="bold"
            android:textSize="9.5sp" />
    </LinearLayout>

    <!-- Interactive Period Filter Pills (1W, 1M, 3W, YTD, Total) -->
    <LinearLayout
        android:id="@+id/widget_pills_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_pill_bar_bg_dark"
        android:padding="2.5dp"
        android:layout_marginBottom="9dp">

        <TextView
            android:id="@+id/widget_tab_1w"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1W"
            android:textColor="#f8fafc"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="3.5dp"
            android:paddingBottom="3.5dp" />

        <TextView
            android:id="@+id/widget_tab_1m"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1M"
            android:textColor="#94a3b8"
            android:textSize="9.5sp"
            android:gravity="center"
            android:paddingTop="3.5dp"
            android:paddingBottom="3.5dp" />

        <TextView
            android:id="@+id/widget_tab_3w"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="3W"
            android:textColor="#94a3b8"
            android:textSize="9.5sp"
            android:gravity="center"
            android:paddingTop="3.5dp"
            android:paddingBottom="3.5dp" />

        <TextView
            android:id="@+id/widget_tab_ytd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="YTD"
            android:textColor="#94a3b8"
            android:textSize="9.5sp"
            android:gravity="center"
            android:paddingTop="3.5dp"
            android:paddingBottom="3.5dp" />

        <TextView
            android:id="@+id/widget_tab_total"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Total"
            android:textColor="#94a3b8"
            android:textSize="9.5sp"
            android:gravity="center"
            android:paddingTop="3.5dp"
            android:paddingBottom="3.5dp" />
    </LinearLayout>

    <!-- Main Analytics: Donut Ring Chart on Left + 4 Stock Breakdown Rows on Right -->
    <LinearLayout
        android:id="@+id/widget_main_analytics_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <!-- Donut Ring Chart ImageView -->
        <ImageView
            android:id="@+id/widget_gauge_img"
            android:layout_width="94dp"
            android:layout_height="94dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="12dp"
            android:contentDescription="Activity Donut Gauge" />

        <!-- 4 Metric Rows with Colored Bullets -->
        <LinearLayout
            android:id="@+id/widget_rows_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Row 1: Total Item (Blue) -->
            <LinearLayout
                android:id="@+id/widget_row_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="2.5dp"
                android:paddingBottom="2.5dp"
                android:layout_marginBottom="2.5dp">
                <ImageView
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/widget_bullet_blue"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/widget_label_total"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total Item"
                    android:textColor="#94a3b8"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/widget_total_items"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#f8fafc"
                    android:textStyle="bold"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Row 2: Low Stock (Orange) -->
            <LinearLayout
                android:id="@+id/widget_row_low"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="2.5dp"
                android:paddingBottom="2.5dp"
                android:layout_marginBottom="2.5dp">
                <ImageView
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/widget_bullet_orange"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/widget_label_low"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Low Stock"
                    android:textColor="#94a3b8"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/widget_low_stock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#f8fafc"
                    android:textStyle="bold"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Row 3: Out of Stock (Pink) -->
            <LinearLayout
                android:id="@+id/widget_row_out"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="2.5dp"
                android:paddingBottom="2.5dp"
                android:layout_marginBottom="2.5dp">
                <ImageView
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/widget_bullet_pink"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/widget_label_out"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Out of Stock"
                    android:textColor="#94a3b8"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/widget_out_stock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#f8fafc"
                    android:textStyle="bold"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Row 4: Tasks to do (Green) -->
            <LinearLayout
                android:id="@+id/widget_row_tasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="2.5dp"
                android:paddingBottom="2.5dp">
                <ImageView
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/widget_bullet_green"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/widget_label_tasks"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tasks to do"
                    android:textColor="#94a3b8"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/widget_tasks_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#f8fafc"
                    android:textStyle="bold"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Task Need To Be Done Box -->
    <LinearLayout
        android:id="@+id/widget_task_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_inner_box_dark"
        android:padding="7dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎯 TASK NEED TO BE DONE:"
            android:textColor="#94a3b8"
            android:textSize="8.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_today_tasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aim 50 (Now 11) • All stocks on track!"
            android:textColor="#f8fafc"
            android:textStyle="bold"
            android:textSize="10.5sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- 2x2 Metric KPI Cards Grid (Nominal Balance, Total Stock, Nominal Revenue, Tasks Remaining) -->
    <LinearLayout
        android:id="@+id/widget_kpi_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <!-- Row 1: Balance + Stock Product -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="5dp">

            <!-- Card 1: Nominal Balance -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/widget_kpi_card_dark"
                android:padding="7dp"
                android:layout_marginEnd="3.5dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/widget_bullet_pink"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@null" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Nominal Balance"
                        android:textColor="#94a3b8"
                        android:textSize="8.5sp"
                        android:singleLine="true" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↑ 1.19%"
                        android:textColor="#10b981"
                        android:textSize="7.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <TextView
                    android:id="@+id/widget_kpi_balance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="26,852 USD"
                    android:textColor="#f8fafc"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginTop="3dp"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Card 2: Total Stock Product -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/widget_kpi_card_dark"
                android:padding="7dp"
                android:layout_marginStart="3.5dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/widget_bullet_blue"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@null" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total Stock Product"
                        android:textColor="#94a3b8"
                        android:textSize="8.5sp"
                        android:singleLine="true" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↑ 0.29%"
                        android:textColor="#10b981"
                        android:textSize="7.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <TextView
                    android:id="@+id/widget_kpi_total_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="89 Items"
                    android:textColor="#f8fafc"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginTop="3dp"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Revenue + Tasks Remaining -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Card 3: Nominal Revenue -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/widget_kpi_card_dark"
                android:padding="7dp"
                android:layout_marginEnd="3.5dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/widget_bullet_green"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@null" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Nominal Revenue"
                        android:textColor="#94a3b8"
                        android:textSize="8.5sp"
                        android:singleLine="true" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↑ 0.29%"
                        android:textColor="#10b981"
                        android:textSize="7.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <TextView
                    android:id="@+id/widget_kpi_revenue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="26,852 USD"
                    android:textColor="#f8fafc"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginTop="3dp"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Card 4: Tasks Remaining -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/widget_kpi_card_dark"
                android:padding="7dp"
                android:layout_marginStart="3.5dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/widget_bullet_purple"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@null" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tasks Remaining"
                        android:textColor="#94a3b8"
                        android:textSize="8.5sp"
                        android:singleLine="true" />
                    <TextView
                        android:id="@+id/widget_kpi_tasks_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ Clear"
                        android:textColor="#10b981"
                        android:textSize="7.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <TextView
                    android:id="@+id/widget_kpi_tasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0 Tasks"
                    android:textColor="#f8fafc"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginTop="3dp"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Spacer to absorb vertical space neatly -->
    <LinearLayout
        android:id="@+id/widget_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <!-- Action Button -->
    <TextView
        android:id="@+id/widget_btn_open"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_btn_bg"
        android:text="Open App &amp; Manage Stock Tasks  ➔"
        android:textColor="#ffffff"
        android:textStyle="bold"
        android:textSize="11sp"
        android:gravity="center"
        android:paddingTop="6.5dp"
        android:paddingBottom="6.5dp" />
</LinearLayout>
